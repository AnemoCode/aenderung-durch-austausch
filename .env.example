DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection.
# Dev:  host is "db" (the service in docker-compose.yml).
# Prod: host is the internal hostname of the Dokploy-managed Postgres
#       (visible in the Dokploy database UI, e.g. "aeda-db-xxxxxx").
POSTGRES_DB=aenderung-durch-austausch
POSTGRES_USER=aenderung-durch-austausch
POSTGRES_PASSWORD=aenderung-durch-austausch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Dev only: path on the host where the local PostgreSQL container stores data.
# Not used in production (Dokploy manages the database volume).
POSTGRES_DATA_PATH=./data/postgres

# Prod only: GHCR owner for the web image pulled by docker-compose.prod.yml.
# GHCR_OWNER=your-github-org-or-user
# IMAGE_TAG=latest
