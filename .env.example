DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True on staging to display seed user credentials on the login page.
STAGING=False

POSTGRES_DB=aenderung-durch-austausch
POSTGRES_USER=aenderung-durch-austausch
POSTGRES_PASSWORD=aenderung-durch-austausch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Path on the host where PostgreSQL data is stored.
# Dev default: ./data/postgres (gitignored local folder)
# Production:  POSTGRES_DATA_PATH=/opt/aenderung-durch-austausch/postgres
POSTGRES_DATA_PATH=./data/postgres

# User-uploaded media (article images in Medienkompetenz, etc.)
# MEDIA_ROOT is the filesystem path inside the container/process.
# MEDIA_HOST_PATH is the host path bind-mounted into MEDIA_ROOT by docker compose.
# Dev defaults persist uploads to ./data/media (gitignored).
# Production: set MEDIA_HOST_PATH=/opt/aenderung-durch-austausch/media (or similar).
MEDIA_ROOT=/app/data/media
MEDIA_URL=/media/
MEDIA_HOST_PATH=./data/media
# Maximum size in bytes for a single inline image upload (default 8 MiB).
MEDIA_UPLOAD_MAX_BYTES=8388608
