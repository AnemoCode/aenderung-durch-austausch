DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True on staging to display seed user credentials on the login page.
STAGING=False

POSTGRES_DB=aenderung-durch-austausch
POSTGRES_USER=aenderung-durch-austausch
POSTGRES_PASSWORD=aenderung-durch-austausch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Path on the host where PostgreSQL data is stored.
# Dev default: ./data/postgres (gitignored local folder)
# Production:  POSTGRES_DATA_PATH=/opt/aenderung-durch-austausch/postgres
POSTGRES_DATA_PATH=./data/postgres

# User-uploaded media (article images in Medienkompetenz, etc.)
# MEDIA_ROOT is the filesystem path inside the container/process.
# MEDIA_HOST_PATH is the host path bind-mounted into MEDIA_ROOT by docker compose.
# Dev defaults persist uploads to ./data/media (gitignored).
# Production: set MEDIA_HOST_PATH=/opt/aenderung-durch-austausch/media (or similar).
MEDIA_ROOT=/app/data/media
MEDIA_URL=/media/
MEDIA_HOST_PATH=./data/media
# Maximum size in bytes for a single inline image upload (default 8 MiB).
MEDIA_UPLOAD_MAX_BYTES=8388608

# ── HTTPS (only used when DEBUG=False) ──────────────────────────────────────
# The reverse proxy already redirects HTTP to HTTPS, so Django doesn't by default.
SECURE_SSL_REDIRECT=False
# Start with 3600 (one hour). Raise to 31536000 (one year) once HTTPS has run
# for a week without trouble. Browsers remember this, so lowering it later is slow.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# ── Error tracking (Sentry) ─────────────────────────────────────────────────
# Leave empty to switch Sentry off. Use a project in the EU region, its DSN
# ends in .de.sentry.io. SENTRY_RELEASE is set from the Git SHA at build time.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Backups (backup service in docker-compose.prod.yml) ─────────────────────
BACKUP_HOST_PATH=/opt/aenderung-durch-austausch/backups
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=30
# Optional offsite copy via rclone, e.g. a Hetzner Storage Box over SFTP.
# The remote is configured through RCLONE_CONFIG_<NAME>_* variables, see
# docs/operations/backup-restore.md. Leave empty to keep backups only locally.
BACKUP_RCLONE_REMOTE=
